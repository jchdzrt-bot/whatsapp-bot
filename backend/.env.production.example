# Copy this file to .env.production and fill in real values.
# NEVER commit real secrets. `npm start` loads this file via dotenv-cli.
PORT=3001
ENVIRONMENT=production

# Mongo DB connection
MONGO_USER=replace-me
MONGO_PASSWORD=replace-me
MONGO_HOST=replace-me
MONGO_PORT=27017
MONGO_DB=whatsapp-bot

# Middleware heads
X_API_KEY=replace-me

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
SALT_ROUNDS=10
