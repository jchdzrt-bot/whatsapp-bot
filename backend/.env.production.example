# Local production helper. Copy this file to .env.production and fill in real
# values; `npm run start:local` loads it AFTER the build via dotenv-cli.
#
# On Render the platform injects these variables natively (see render.yaml), so
# the deployed `npm start` runs the compiled server against the dashboard env
# vars and never reads this file. NEVER commit real secrets.
PORT=3001
ENVIRONMENT=production

# Mongo DB connection
MONGO_USER=replace-me
MONGO_PASSWORD=replace-me
MONGO_HOST=replace-me
MONGO_PORT=27017
MONGO_DB=whatsapp-bot

# Middleware heads
X_API_KEY=replace-me

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
SALT_ROUNDS=10

# CORS: comma-separated list of browser origins allowed to call this API in
# production, e.g. https://whatsapp-bot-frontend.onrender.com or your custom
# domain. http://localhost:5173 and http://127.0.0.1:5173 stay allowed for dev.
# On Render this value is prompted for on first blueprint sync
# (render.yaml → backend.envVars.ALLOWED_CORS_ORIGINS).
ALLOWED_CORS_ORIGINS=https://your-frontend.onrender.com
