{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "api.ts",
    "setupBusiness/constants.ts",
    "types.ts",
    "setupBusiness",
    "createUser.ts/**/*",
    "updateServices/**/*"
  ]
}