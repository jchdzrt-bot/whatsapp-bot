# Copy this file to .env for local development.
# Vite exposes BACKEND_* vars to the bundle via the envPrefix list in
# vite.config.ts (frontend/src/api/apiCall.ts reads it from import.meta.env).
BACKEND_URL="http://localhost:3001"

# In production (Render static site) this value is provided by the platform at
# build time through render.yaml (BACKEND_URL <- backend service URL), so the
# committed .env file is NOT used.